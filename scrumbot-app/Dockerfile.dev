FROM public.ecr.aws/lambda/python:3.12

# Install prod dependencies to standard site-packages (not LAMBDA_TASK_ROOT)
# so the Flask dev server can import them normally
COPY requirements.txt .
RUN pip install -r requirements.txt --no-cache-dir

# Install Flask for the local dev server
RUN pip install flask==3.0.3 --no-cache-dir

WORKDIR /app

# Override the Lambda base image entrypoint — we run Flask, not the Lambda RIC
ENTRYPOINT []
CMD ["python", "local_server.py"]
